#!/usr/bin/env bash
# plannotator-review — one persistent review page per CODING SESSION.
#
# Model (option B): all /annotate|/cmt invocations in a coding session (launch→
# exit of codex/claude/opencode) share ONE server on ONE fixed port (one browser
# tab), at most one active review at a time. Past reviews stay viewable read-only
# via `plannotator archive`. The session's server is reaped when the session ends.
#
# Session identity (OWNER): a value that is STABLE across every tool call in the
# session and DIFFERENT between sessions. In priority order:
#   1. $PLANNOTATOR_REVIEW_OWNER (explicit override)
#   2. a coding-agent session env var (CLAUDE_CODE_SESSION_ID / CODEX_* / OPENCODE_*)
#   3. the top-most coding-agent ancestor PID (matched by executable NAME, not by
#      a substring of the command line — a temp path like /tmp/claude-XXX must not
#      match), which is also recorded for liveness-based reaping
#   4. the controlling tty (aged out)
#
# Subcommands:
#   start <annotate <file> | annotate-last | review [PR]>   (re)start on the
#       session's fixed port, detached; opens the browser only on the first start.
#   wait                          poll for the decision; prints {"decision":...} |
#       PLANNOTATOR_STILL_WAITING (re-run to keep the SAME page) | PLANNOTATOR_SESSION_ENDED
#   cleanup [--list|--all]        reap ended sessions / list / kill all.
set -o pipefail

DATA_DIR="${PLANNOTATOR_DATA_DIR:-$HOME/.plannotator}"
STATE_ROOT="$DATA_DIR/review-sessions"
POLL_BUDGET="${PLANNOTATOR_POLL_BUDGET:-540}"   # seconds a single `wait` blocks (< agent 10-min cap)
TTY_MAX_AGE="${PLANNOTATOR_TTY_MAX_AGE:-10800}" # reap tty/sh sessions older than this (s)
mkdir -p "$STATE_ROOT"

die() { printf '%s\n' "$1" >&2; exit 2; }

# Top-most coding-agent ancestor PID, matched by executable NAME (comm), so a
# command line that merely contains "claude"/"codex" (e.g. a temp dir) can't
# false-match. Empty if none found.
detect_agent_pid() {
  local pid="$PPID" comm i=0 top=""
  while [ "${pid:-0}" -gt 1 ] && [ "$i" -lt 30 ]; do
    comm="$(ps -o comm= -p "$pid" 2>/dev/null)"; comm="${comm##*/}"; comm="${comm#-}"
    case "$comm" in codex|Codex|claude|Claude|opencode|OpenCode) top="$pid" ;; esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    i=$((i + 1))
  done
  printf '%s\n' "$top"
}

detect_owner() {
  if [ -n "${PLANNOTATOR_REVIEW_OWNER:-}" ]; then printf '%s\n' "$PLANNOTATOR_REVIEW_OWNER"; return; fi
  # Stable per-session env vars, inherited by every tool call in the session.
  # Confirmed by binary inspection (2026-07): Claude Code exports
  # CLAUDE_CODE_SESSION_ID; Codex and OpenCode export NO session id env var, so
  # they fall through to the coding-agent process match below (their processes
  # are literally named `codex` / `opencode`). The CODEX_*/OPENCODE_* checks are
  # harmless forward-compat in case those tools add such a var later.
  [ -n "${CLAUDE_CODE_SESSION_ID:-}" ] && { printf 'claude-%s\n' "$CLAUDE_CODE_SESSION_ID"; return; }
  [ -n "${CODEX_THREAD_ID:-}"        ] && { printf 'codex-%s\n'  "$CODEX_THREAD_ID";        return; }  # Codex per-session id (confirmed)
  [ -n "${OPENCODE_PID:-}"           ] && { printf 'opencode-%s\n' "$OPENCODE_PID";         return; }  # OpenCode server pid, stable per session
  [ -n "${CODEX_SESSION_ID:-}"       ] && { printf 'codex-%s\n'  "$CODEX_SESSION_ID";       return; }  # forward-compat
  [ -n "${OPENCODE_SESSION_ID:-}"    ] && { printf 'opencode-%s\n' "$OPENCODE_SESSION_ID";  return; }  # forward-compat
  local ap; ap="$(detect_agent_pid)"
  [ -n "$ap" ] && { printf '%s\n' "$ap"; return; }
  local t; t="$(ps -o tty= -p $$ 2>/dev/null | tr -d ' ' | tr '/' '-')"
  [ -n "$t" ] && printf 'tty-%s\n' "$t" || printf 'sh-%s\n' "$PPID"
}

sanitize() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-'; }
owner_is_pid() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

pick_free_port() {
  local p i
  for i in $(seq 1 60); do
    p=$(( (RANDOM % 20000) + 20000 ))
    lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1 || { printf '%s\n' "$p"; return; }
  done
  printf '0\n'
}

# The recorded pid is the node shim (bin/plannotator.js) which spawns `bun` (the
# server holding the port). Kill the child(ren) first, then the shim.
kill_server() {
  local sp; sp="$(cat "$1/server.pid" 2>/dev/null)"; [ -n "$sp" ] || return 0
  pkill -P "$sp" 2>/dev/null
  kill "$sp" 2>/dev/null
  return 0
}

# Reap sessions whose coding agent has exited (by stored agent pid, else numeric
# owner key), or tty/sh sessions past the age cap.
reap_ended() {
  local d o opid now age
  now="$(date +%s)"
  for d in "$STATE_ROOT"/*/; do
    [ -d "$d" ] || continue
    o="$(basename "$d")"
    opid="$(cat "$d/owner.pid" 2>/dev/null)"
    if [ -n "$opid" ]; then
      kill -0 "$opid" 2>/dev/null || { kill_server "$d"; rm -rf "$d"; }
    elif owner_is_pid "$o"; then
      kill -0 "$o" 2>/dev/null || { kill_server "$d"; rm -rf "$d"; }
    else
      age=$(( now - $(stat -f %m "$d" 2>/dev/null || stat -c %Y "$d" 2>/dev/null || echo "$now") ))
      [ "$age" -gt "$TTY_MAX_AGE" ] && { kill_server "$d"; rm -rf "$d"; }
    fi
  done
}

cmd="${1:-}"; shift 2>/dev/null || true
OWNER="$(sanitize "$(detect_owner)")"; [ -n "$OWNER" ] || OWNER="sh-$PPID"
SDIR="$STATE_ROOT/$OWNER"

case "$cmd" in
  start)
    command -v plannotator >/dev/null 2>&1 || die "plannotator not found on PATH"
    [ "$#" -ge 1 ] || die "usage: plannotator-review start <annotate <file> | annotate-last | review [PR]>"
    reap_ended
    mkdir -p "$SDIR"
    # Record the coding-agent pid (if any) so reaping can key on its liveness
    # even when OWNER is an env-var session id.
    ap="$(detect_agent_pid)"; if [ -n "$ap" ]; then printf '%s\n' "$ap" > "$SDIR/owner.pid"; else rm -f "$SDIR/owner.pid"; fi
    # Fixed port for this coding session.
    port="$(cat "$SDIR/port" 2>/dev/null)"
    if [ -z "$port" ]; then port="$(pick_free_port)"; [ "$port" = 0 ] && die "no free port found"; printf '%s\n' "$port" > "$SDIR/port"; fi
    # One active review at a time: stop this session's previous server if still up.
    kill_server "$SDIR"
    : > "$SDIR/result"
    # Open the browser only on the first review of this coding session; later
    # reviews reuse the same tab (same fixed URL) via the page's self-reload.
    BENV=""
    if [ -f "$SDIR/opened" ]; then BENV="PLANNOTATOR_BROWSER=none"; else : > "$SDIR/opened"; fi
    # shellcheck disable=SC2086
    nohup env PLANNOTATOR_SHARE=disabled PLANNOTATOR_PORT="$port" $BENV \
      plannotator "$@" --json > "$SDIR/result" 2>&1 </dev/null &
    printf '%s\n' "$!" > "$SDIR/server.pid"
    disown 2>/dev/null || true
    echo "PLANNOTATOR_STARTED owner=$OWNER port=$port url=http://localhost:$port — now run: plannotator-review wait"
    ;;

  wait)
    [ -f "$SDIR/result" ] || die "no active review for this coding session (owner=$OWNER) — run 'plannotator-review start ...' first"
    result="$SDIR/result"; pidf="$SDIR/server.pid"
    deadline=$(( $(date +%s) + POLL_BUDGET ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      if grep -q '"decision"' "$result" 2>/dev/null; then
        grep '"decision"' "$result" | tail -1; rm -f "$pidf" "$result"; exit 0
      fi
      sp="$(cat "$pidf" 2>/dev/null)"
      if [ -z "$sp" ] || ! kill -0 "$sp" 2>/dev/null; then
        for _ in 1 2 3 4 5 6; do
          grep -q '"decision"' "$result" 2>/dev/null && { grep '"decision"' "$result" | tail -1; rm -f "$pidf" "$result"; exit 0; }
          sleep 1
        done
        echo "PLANNOTATOR_SESSION_ENDED — review window closed without a response"; rm -f "$pidf" "$result"; exit 0
      fi
      sleep 2
    done
    echo "PLANNOTATOR_STILL_WAITING — not submitted yet; re-run 'plannotator-review wait' to keep the SAME page open (do not 'start' again)"
    exit 0
    ;;

  cleanup)
    case "${1:-}" in
      --list)
        for d in "$STATE_ROOT"/*/; do [ -d "$d" ] || continue; o="$(basename "$d")"
          opid="$(cat "$d/owner.pid" 2>/dev/null)"
          if [ -n "$opid" ]; then kill -0 "$opid" 2>/dev/null && s="alive(agent $opid)" || s="DEAD(agent $opid)"
          elif owner_is_pid "$o"; then kill -0 "$o" 2>/dev/null && s=alive || s=DEAD
          else s="tty/age"; fi
          echo "$o  $s  port=$(cat "$d/port" 2>/dev/null)"; done ;;
      --all)
        for d in "$STATE_ROOT"/*/; do [ -d "$d" ] || continue; kill_server "$d"; rm -rf "$d"; done; echo "cleaned all review sessions" ;;
      *) reap_ended; echo "reaped review sessions whose coding agent has exited" ;;
    esac
    ;;

  *) die "usage: plannotator-review <start|wait|cleanup> <annotate <file> | annotate-last | review [PR]>" ;;
esac
